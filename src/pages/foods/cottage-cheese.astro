---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { foods } from '../../data/foods.js';
import { foodLists } from '../../data/foodLists.js';
import { comparisons } from '../../data/comparisons.js';
import { recipes } from '../../data/recipes.js';

const food = foods.find((f) => f.name === 'Cottage cheese (low-fat)');
const slug = 'cottage-cheese';
const displayName = 'Cottage Cheese';
const url = `https://welanutria.com/foods/${slug}/`;

const factor = food.servingG / 100;
const per = (v) => Math.round(v * factor * 10) / 10;

const badges = [];
if (food.protein >= 9) badges.push('High protein');
if (food.cal <= 120) badges.push('Low calorie');
if (food.fat <= 3) badges.push('Low fat');
if (food.carbs <= 10) badges.push('Low carb');
badges.push('Vegetarian');

const ROWS = [
  { key: 'cal', label: 'Calories', unit: 'kcal' },
  { key: 'protein', label: 'Protein', unit: 'g' },
  { key: 'carbs', label: 'Carbs', unit: 'g' },
  { key: 'fat', label: 'Fat', unit: 'g' },
  { key: 'sugar', label: 'Sugar', unit: 'g' },
  { key: 'calcium', label: 'Calcium', unit: 'mg' },
  { key: 'potassium', label: 'Potassium', unit: 'mg' },
  { key: 'b12', label: 'Vitamin B12', unit: 'mcg' },
  { key: 'zinc', label: 'Zinc', unit: 'mg' },
];
const rows = ROWS.filter((r) => food[r.key] > 0);

const inLists = foodLists.filter((l) => { try { return l.filter && l.filter(food); } catch { return false; } });
const inComparisons = comparisons.filter((c) => JSON.stringify(c).toLowerCase().includes('cottage cheese'));
const inRecipes = recipes.filter((r) => JSON.stringify(r).toLowerCase().includes('cottage cheese'));

const faqs = [
  { q: 'How much protein is in cottage cheese?', a: `Low-fat cottage cheese has around ${food.protein} g of protein per 100 g, or roughly ${per(food.protein)} g in a ${food.servingG} g serving. That makes it one of the most protein-dense foods you can keep in the fridge.` },
  { q: 'How many calories are in cottage cheese?', a: `Around ${food.cal} calories per 100 g, or about ${per(food.cal)} in a ${food.servingG} g serving. Combined with its high protein and low fat, this makes it filling for very few calories.` },
  { q: 'Is cottage cheese good for weight loss?', a: 'Yes. It is high in protein and low in calories, a combination that controls appetite and helps preserve muscle while losing weight. It is filling and versatile in both sweet and savoury dishes.' },
  { q: 'Is cottage cheese good for building muscle?', a: 'Very much so. Its high protein supports muscle repair and growth, and it contains casein, a slow-digesting protein often eaten before bed to supply amino acids overnight.' },
  { q: 'Does cottage cheese have calcium?', a: `Yes, around ${food.calcium} mg per 100 g, a useful contribution to bone health, alongside vitamin B12 and other nutrients.` },
];

const nutritionSchema = {
  '@context': 'https://schema.org', '@type': 'NutritionInformation', name: displayName,
  calories: `${food.cal} kcal`, proteinContent: `${food.protein} g`,
  carbohydrateContent: `${food.carbs} g`, fatContent: `${food.fat} g`, servingSize: '100 g',
};
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://welanutria.com/' },
    { '@type': 'ListItem', position: 2, name: displayName, item: url },
  ],
};
---
<Base
  title={`${displayName} Nutrition: Protein, Calories & Benefits`}
  description={`${displayName} nutrition per 100g and per serving: ${food.cal} calories, ${food.protein}g protein, ${food.calcium}mg calcium. Benefits, recipes and how to eat it.`}
  current=""
>
  <script type="application/ld+json" set:html={JSON.stringify(nutritionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span>/</span><span>{displayName}</span>
  </nav>

  <section class="wrap fh-hero">
    <div class="fh-hero-text">
      <p class="fh-eyebrow">{food.category}</p>
      <h1>{displayName}</h1>
      <p class="fh-lede">A high-protein, low-calorie dairy food, and one of the most versatile things you can keep in the fridge. Here is its full nutrition and everything on the site to help you use it.</p>
      <div class="fh-badges">
        {badges.map((b) => <span class="fh-badge">{b}</span>)}
      </div>
    </div>
    <div class="fh-hero-stats">
      <div class="fh-stat fh-stat-lead"><span class="fh-num">{food.protein}g</span><span class="fh-lbl">protein per 100g</span></div>
      <div class="fh-stat"><span class="fh-num">{food.cal}</span><span class="fh-lbl">calories</span></div>
      <div class="fh-stat"><span class="fh-num">{food.calcium}mg</span><span class="fh-lbl">calcium</span></div>
    </div>
  </section>

  <section class="wrap section">
    <h2>Nutrition facts</h2>
    <table class="fh-table">
      <thead><tr><th>Nutrient</th><th>Per 100g</th><th>Per {food.servingG}g serving</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr><td>{r.label}</td><td>{food[r.key]}{r.unit === 'kcal' ? '' : ' ' + r.unit}</td><td>{per(food[r.key])}{r.unit === 'kcal' ? '' : ' ' + r.unit}</td></tr>
        ))}
      </tbody>
    </table>
    <p class="fh-note">Per 100 g. Values are approximate and vary by brand.</p>
  </section>

  <section class="wrap section fh-prose">
    <h2>Why cottage cheese is good for you</h2>
    <p>Cottage cheese earns its popularity: it is <strong>very high in protein</strong> ({food.protein}g per 100g) for muscle and fullness, <strong>low in calories and fat</strong>, and a useful source of <strong>calcium and vitamin B12</strong>. The main thing to watch is sodium, which can be high in some brands. For the full breakdown, see our <a href="/blog/cottage-cheese-nutrition/">cottage cheese nutrition guide</a>.</p>
  </section>

  <section class="wrap section">
    <h2>How to eat it</h2>
    <div class="fh-eat">
      <div class="fh-eat-col">
        <h3>Sweet</h3>
        <ul><li>Fruit and honey bowl</li><li>Blended into pancakes</li><li>With berries and seeds</li><li>Frozen "ice cream"</li></ul>
      </div>
      <div class="fh-eat-col">
        <h3>Savoury</h3>
        <ul><li>On toast with tomato</li><li>Whipped into a dip</li><li>Stirred into pasta sauce</li><li>With cucumber and pepper</li></ul>
      </div>
    </div>
  </section>

  {inRecipes.length > 0 && (
    <section class="wrap section">
      <h2>Recipes with cottage cheese</h2>
      <div class="fh-recipes">
        {inRecipes.map((r) => (
          <a class="fh-recipe" href={`/recipes/${r.slug}/`}>
            <img src={`/img/recipes/${r.image}`} alt={r.title} loading="lazy" />
            <div class="fh-recipe-body">
              <span class="fh-recipe-title">{r.title}</span>
              {r.macros && <span class="fh-recipe-macros">{r.macros.cal} cal &middot; {r.macros.protein}g protein</span>}
            </div>
          </a>
        ))}
        <a class="fh-recipe fh-recipe-more" href="/blog/cottage-cheese-recipes/">
          <div class="fh-recipe-body"><span class="fh-recipe-title">More cottage cheese ideas &rarr;</span></div>
        </a>
      </div>
    </section>
  )}

  <section class="wrap section fh-explore">
    {inComparisons.length > 0 && (
      <div class="fh-explore-group">
        <h2>Compare it</h2>
        <div class="fh-chips">
          {inComparisons.map((c) => <a class="fh-chip" href={`/compare/${c.slug}/`}>{c.title}</a>)}
        </div>
      </div>
    )}
    {inLists.length > 0 && (
      <div class="fh-explore-group">
        <h2>Featured in these lists</h2>
        <div class="fh-chips">
          {inLists.map((l) => <a class="fh-chip" href={`/food-lists/${l.slug}/`}>{l.title}</a>)}
        </div>
      </div>
    )}
  </section>

  <section class="wrap section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqs} />
  </section>

  <style>
    .crumbs{padding:20px 0 0;font-size:.85rem;color:var(--muted);display:flex;gap:8px;align-items:center}
    .crumbs a{color:var(--muted)}.crumbs a:hover{color:var(--accent)}
    .fh-hero{display:grid;grid-template-columns:1.4fr 1fr;gap:36px;align-items:center;padding:32px 0 40px}
    @media(max-width:720px){.fh-hero{grid-template-columns:1fr;gap:24px}}
    .fh-eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.8rem;font-weight:600;color:var(--accent);margin:0 0 6px}
    .fh-hero h1{font-size:clamp(2rem,5vw,3rem);letter-spacing:-.02em;margin:0 0 12px}
    .fh-lede{font-size:1.1rem;color:#3F4F49;max-width:52ch;margin:0 0 18px;line-height:1.6}
    .fh-badges{display:flex;flex-wrap:wrap;gap:8px}
    .fh-badge{background:var(--paper-2);color:var(--accent-deep);border-radius:100px;padding:5px 13px;font-size:.82rem;font-weight:600}
    .fh-hero-stats{display:flex;flex-direction:column;gap:10px}
    .fh-stat{background:var(--cool);border:1px solid var(--cool-line);border-radius:var(--radius);padding:16px 20px;display:flex;align-items:baseline;gap:10px}
    .fh-stat-lead{background:var(--accent);border-color:var(--accent)}
    .fh-stat-lead .fh-num,.fh-stat-lead .fh-lbl{color:#fff}
    .fh-num{font-size:1.7rem;font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1}
    .fh-lbl{font-size:.85rem;color:var(--muted)}
    .section{padding:34px 0 0}
    .section h2{font-size:1.4rem;letter-spacing:-.02em;margin:0 0 16px}
    .fh-table{width:100%;border-collapse:collapse;font-size:.95rem}
    .fh-table th,.fh-table td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--line)}
    .fh-table th{font-weight:600;color:var(--muted);font-size:.8rem;text-transform:uppercase;letter-spacing:.04em}
    .fh-table td:first-child{font-weight:600;color:var(--ink)}
    .fh-note{font-size:.82rem;color:var(--muted);margin:12px 0 0}
    .fh-prose p{font-size:1.02rem;line-height:1.7;color:#33453F;max-width:66ch}
    .fh-eat{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    @media(max-width:560px){.fh-eat{grid-template-columns:1fr}}
    .fh-eat-col{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:18px 22px}
    .fh-eat-col h3{margin:0 0 10px;font-size:1rem;color:var(--accent)}
    .fh-eat-col ul{margin:0;padding-left:18px;color:#33453F}
    .fh-eat-col li{margin:5px 0;line-height:1.5}
    .fh-recipes{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px}
    .fh-recipe{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:.15s;display:flex;flex-direction:column}
    .fh-recipe:hover{border-color:var(--accent);transform:translateY(-2px);text-decoration:none}
    .fh-recipe img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
    .fh-recipe-body{padding:12px 14px}
    .fh-recipe-title{display:block;font-weight:700;color:var(--ink);font-size:.95rem;line-height:1.3}
    .fh-recipe-macros{display:block;font-size:.82rem;color:var(--muted);margin-top:4px}
    .fh-recipe-more{justify-content:center;align-items:center;min-height:120px;background:var(--paper)}
    .fh-explore-group{margin-bottom:24px}
    .fh-chips{display:flex;flex-wrap:wrap;gap:8px}
    .fh-chip{background:#fff;border:1px solid var(--line);border-radius:100px;padding:8px 16px;font-size:.9rem;font-weight:600;color:var(--ink);transition:.15s}
    .fh-chip:hover{border-color:var(--accent);color:var(--accent);text-decoration:none}
  </style>
</Base>
