---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { foods } from '../../data/foods.js';
import { foodLists } from '../../data/foodLists.js';
import { comparisons } from '../../data/comparisons.js';
import { recipes } from '../../data/recipes.js';

// --- PILOT: hard-coded to cottage cheese to preview the concept ---
const food = foods.find((f) => f.name === 'Cottage cheese (low-fat)');
const slug = 'cottage-cheese';
const displayName = 'Cottage Cheese';
const url = `https://welanutria.com/foods/${slug}/`;

// Per-serving values
const factor = food.servingG / 100;
const per = (v) => Math.round(v * factor * 10) / 10;

// Nutrition rows to show (skip zeros)
const ROWS = [
  { key: 'cal', label: 'Calories', unit: 'kcal' },
  { key: 'protein', label: 'Protein', unit: 'g' },
  { key: 'carbs', label: 'Carbs', unit: 'g' },
  { key: 'fat', label: 'Fat', unit: 'g' },
  { key: 'sugar', label: 'Sugar', unit: 'g' },
  { key: 'calcium', label: 'Calcium', unit: 'mg' },
  { key: 'potassium', label: 'Potassium', unit: 'mg' },
  { key: 'b12', label: 'Vitamin B12', unit: 'mcg' },
  { key: 'zinc', label: 'Zinc', unit: 'mg' },
];
const rows = ROWS.filter((r) => food[r.key] > 0);

// Which food lists this food qualifies for
const inLists = foodLists.filter((l) => {
  try { return l.filter && l.filter(food); } catch { return false; }
});

// Comparisons featuring this food
const inComparisons = comparisons.filter((c) =>
  JSON.stringify(c).toLowerCase().includes('cottage cheese')
);

// Recipes featuring this food
const inRecipes = recipes.filter((r) =>
  JSON.stringify(r).toLowerCase().includes('cottage cheese')
);

const faqs = [
  { q: 'How much protein is in cottage cheese?', a: `Low-fat cottage cheese has around ${food.protein} g of protein per 100 g, or roughly ${per(food.protein)} g in a ${food.servingG} g serving. That makes it one of the most protein-dense foods you can keep in the fridge.` },
  { q: 'How many calories are in cottage cheese?', a: `Around ${food.cal} calories per 100 g, or about ${per(food.cal)} in a ${food.servingG} g serving. Combined with its high protein and low fat, this makes it filling for very few calories.` },
  { q: 'Is cottage cheese good for weight loss?', a: 'Yes. It is high in protein and low in calories, a combination that controls appetite and helps preserve muscle while losing weight. It is filling and versatile in both sweet and savoury dishes.' },
  { q: 'Is cottage cheese good for building muscle?', a: 'Very much so. Its high protein supports muscle repair and growth, and it contains casein, a slow-digesting protein often eaten before bed to supply amino acids overnight.' },
  { q: 'Does cottage cheese have calcium?', a: `Yes, around ${food.calcium} mg per 100 g, a useful contribution to bone health, alongside vitamin B12 and other nutrients.` },
];

const nutritionSchema = {
  '@context': 'https://schema.org',
  '@type': 'NutritionInformation',
  name: displayName,
  calories: `${food.cal} kcal`,
  proteinContent: `${food.protein} g`,
  carbohydrateContent: `${food.carbs} g`,
  fatContent: `${food.fat} g`,
  servingSize: '100 g',
};
---
<Base
  title={`${displayName} Nutrition: Protein, Calories & Benefits`}
  description={`${displayName} nutrition per 100g and per serving: ${food.cal} calories, ${food.protein}g protein, ${food.calcium}mg calcium. Benefits, recipes and how to eat it.`}
  current=""
>
  <script type="application/ld+json" set:html={JSON.stringify(nutritionSchema)} />

  <section class="wrap fh">
    <p class="fh-eyebrow">{food.category}</p>
    <h1>{displayName}</h1>
    <p class="fh-lede">A high-protein, low-calorie dairy food, and one of the most versatile things you can keep in the fridge. Here is its full nutrition, benefits, and everything on the site to help you use it.</p>

    <div class="fh-stats">
      <div class="fh-stat"><span class="fh-num">{food.cal}</span><span class="fh-lbl">calories</span></div>
      <div class="fh-stat"><span class="fh-num">{food.protein}g</span><span class="fh-lbl">protein</span></div>
      <div class="fh-stat"><span class="fh-num">{food.calcium}mg</span><span class="fh-lbl">calcium</span></div>
      <div class="fh-stat"><span class="fh-num">{food.fat}g</span><span class="fh-lbl">fat</span></div>
    </div>
    <p class="fh-note">Per 100 g. Values are approximate and vary by brand.</p>
  </section>

  <section class="wrap section">
    <h2>Nutrition facts</h2>
    <table class="fh-table">
      <thead><tr><th>Nutrient</th><th>Per 100g</th><th>Per {food.servingG}g serving</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr><td>{r.label}</td><td>{food[r.key]}{r.unit === 'kcal' ? '' : ' ' + r.unit}</td><td>{per(food[r.key])}{r.unit === 'kcal' ? '' : ' ' + r.unit}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap section">
    <h2>Why cottage cheese is good for you</h2>
    <p>Cottage cheese earns its popularity: it is <strong>very high in protein</strong> ({food.protein}g per 100g) for muscle and fullness, <strong>low in calories and fat</strong>, and a useful source of <strong>calcium and vitamin B12</strong>. It works in both sweet dishes (fruit bowls, blended into pancakes) and savoury ones (dips, pasta sauces, on toast). The main thing to watch is sodium, which can be high in some brands.</p>
    <p>For the full breakdown, see our <a href="/blog/cottage-cheese-nutrition/">cottage cheese nutrition guide</a>.</p>
  </section>

  {inComparisons.length > 0 && (
    <section class="wrap section">
      <h2>Compare cottage cheese</h2>
      <div class="fh-cards">
        {inComparisons.map((c) => (
          <a class="fh-card" href={`/compare/${c.slug}/`}>{c.title}</a>
        ))}
      </div>
    </section>
  )}

  {inRecipes.length > 0 && (
    <section class="wrap section">
      <h2>Recipes with cottage cheese</h2>
      <div class="fh-cards">
        {inRecipes.map((r) => (
          <a class="fh-card" href={`/recipes/${r.slug}/`}>{r.title}</a>
        ))}
        <a class="fh-card" href="/blog/cottage-cheese-recipes/">More cottage cheese ideas</a>
      </div>
    </section>
  )}

  {inLists.length > 0 && (
    <section class="wrap section">
      <h2>Cottage cheese appears in these food lists</h2>
      <div class="fh-cards">
        {inLists.map((l) => (
          <a class="fh-card" href={`/food-lists/${l.slug}/`}>{l.title}</a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqs} />
  </section>

  <style>
    .fh{padding:56px 0 32px}
    .fh-eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.8rem;font-weight:600;color:var(--accent);margin:0 0 6px}
    .fh h1{font-size:clamp(2rem,5vw,3rem);letter-spacing:-.02em;margin:0 0 12px}
    .fh-lede{font-size:1.15rem;color:#3F4F49;max-width:60ch;margin:0 0 28px;line-height:1.6}
    .fh-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:640px}
    @media(max-width:560px){.fh-stats{grid-template-columns:repeat(2,1fr)}}
    .fh-stat{background:var(--cool);border:1px solid var(--line);border-radius:var(--radius);padding:18px 16px;text-align:center}
    .fh-num{display:block;font-size:1.7rem;font-weight:800;color:var(--ink);letter-spacing:-.02em}
    .fh-lbl{display:block;font-size:.82rem;color:var(--muted);margin-top:2px}
    .fh-note{font-size:.82rem;color:var(--muted);margin:12px 0 0}
    .section{padding:36px 0 0}
    .section h2{font-size:1.4rem;letter-spacing:-.02em;margin:0 0 16px}
    .fh-table{width:100%;border-collapse:collapse;font-size:.95rem}
    .fh-table th,.fh-table td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--line)}
    .fh-table th{font-weight:600;color:var(--muted);font-size:.82rem;text-transform:uppercase;letter-spacing:.04em}
    .fh-table td:first-child{font-weight:600;color:var(--ink)}
    .fh-cards{display:flex;flex-wrap:wrap;gap:10px}
    .fh-card{display:inline-flex;align-items:center;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:12px 18px;font-weight:600;font-size:.94rem;color:var(--ink);transition:.15s}
    .fh-card:hover{border-color:var(--accent);color:var(--accent);text-decoration:none;transform:translateY(-2px)}
  </style>
</Base>
